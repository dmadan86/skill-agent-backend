<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Set Up Your Jobready Account</title>
  <style>
    :root {
      color-scheme: light;
      supported-color-schemes: light;
    }
    
    html, body {
      margin: 0 auto !important;
      padding: 0 !important;
      height: 100% !important;
      width: 100% !important;
    }
    
    * {
      -ms-text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
      box-sizing: border-box;
    }
    
    div[style*="margin: 16px 0"] { 
      margin: 0 !important; 
    }
    
    table, td {
      mso-table-lspace: 0pt !important;
      mso-table-rspace: 0pt !important;
    }
    
    table {
      border-spacing: 0 !important;
      border-collapse: collapse !important;
      table-layout: fixed !important;
      margin: 0 auto !important;
    }
    
    img {
      -ms-interpolation-mode: bicubic;
      max-width: 100%;
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol';
      line-height: 1.6;
      color: #111827;
      background-color: #f3f4f6;
      margin: 0;
      padding: 0;
    }
    
    a {
      color: #2563EB;
      text-decoration: none;
    }
    
    a:hover {
      text-decoration: underline;
    }
    
    h1, h2, h3, h4, h5, h6 {
      color: #111827;
      margin-top: 20px;
      margin-bottom: 10px;
      font-weight: 600;
      line-height: 1.3;
    }
    
    h1 { font-size: 24px; }
    h2 { font-size: 20px; }
    h3 { font-size: 18px; }
    
    p, ul, ol {
      font-size: 16px;
      font-weight: normal;
      margin: 0 0 16px;
    }
    
    .wrapper {
      width: 100%;
      table-layout: fixed;
      background-color: #f3f4f6;
      padding: 40px 10px;
    }
    
    .container {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 8px;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
      overflow: hidden;
    }
    
    .header {
      padding: 24px;
      background-color: #000000;
      text-align: center;
    }
    
    .header-content {
      max-width: 100%;
      margin: 0 auto;
    }
    
    .logo-container {
      margin-bottom: 16px;
    }
    
    .title-container {
      margin-top: 12px;
    }
    
    .header-title {
      color: #ffffff;
      font-size: 22px;
      font-weight: 600;
      margin: 0;
      padding: 0;
    }
    
    .content {
      padding: 32px 24px;
      background-color: #ffffff;
    }
    
    .footer {
      background-color: #f9fafb;
      color: #6b7280;
      font-size: 13px;
      text-align: center;
      padding: 24px;
      border-top: 1px solid #e5e7eb;
    }
    
    .footer p {
      font-size: 13px;
      color: #6b7280;
      margin: 0 0 8px;
    }
    
    .footer a {
      color: #4b5563;
      text-decoration: none;
    }
    
    .social-links {
      margin: 12px 0;
    }
    
    .social-links a {
      display: inline-block;
      margin: 0 8px;
      color: #4b5563;
      text-decoration: none;
    }
    
    .btn {
      display: inline-block;
      padding: 12px 28px;
      background-color: #000000;
      color: #ffffff !important;
      text-decoration: none;
      font-weight: 600;
      font-size: 16px;
      border-radius: 6px;
      text-align: center;
      -webkit-transition: all 0.15s ease;
      transition: all 0.15s ease;
      box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      cursor: pointer;
      outline: none;
      border: none;
    }
    
    .btn:hover {
      background-color: #1f2937;
      text-decoration: none;
    }
    
    .btn-container {
      text-align: center;
      margin: 30px 0;
    }
    
    .alert-box {
      background-color: #fef2f2;
      border-radius: 6px;
      padding: 16px;
      margin: 20px 0;
      border-left: 4px solid #ef4444;
      color: #991b1b;
    }
    
    .info-box {
      background-color: #eff6ff;
      border-radius: 6px;
      padding: 16px;
      margin: 20px 0;
      border-left: 4px solid #3b82f6;
      color: #1e40af;
    }
    
    .divider {
      border-top: 1px solid #e5e7eb;
      margin: 24px 0;
      height: 0;
      width: 100%;
    }
    
    .link-text {
      word-break: break-all;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 14px;
      color: #4b5563;
      background-color: #f3f4f6;
      padding: 8px;
      border-radius: 4px;
      margin-top: 8px;
      line-height: 1.4;
    }
    
    .copyright {
      margin-top: 16px;
      color: #9ca3af;
      font-size: 12px;
    }
    
    @media screen and (max-width: 600px) {
      .wrapper {
        padding: 20px 10px;
      }
      
      .header, .content, .footer {
        padding: 20px;
      }
      
      h1 { font-size: 22px; }
      h2 { font-size: 18px; }
      h3 { font-size: 16px; }
      
      .btn {
        display: block;
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <table class="container" width="100%" cellpadding="0" cellspacing="0" role="presentation">
      <tr>
        <td>
          <!-- Header -->
          <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
            <tr>
              <td class="header">
                <div class="header-content">
                  <div class="logo-container">
                    <img src="https://app.jobready.co/logo_long_white.png" alt="DigitalAgents" width="150" height="40" style="max-width: 100%; object-fit: contain;">
                  </div>
                  <div class="title-container">
                    <h1 class="header-title">Set Up Your Account</h1>
                  </div>
                </div>
              </td>
            </tr>
          </table>
          
          <!-- Content -->
          <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
            <tr>
              <td class="content">
                <h2 style="margin-top: 0;">Hello {{userName}},</h2>
                
                <p>An account has been created for you on the Jobready platform. To get started, you'll need to set up your password by clicking the secure link below.</p>
                
                <div class="info-box">
                  <p><strong>What happens next:</strong> When you click the link, you'll be taken to a secure page where you can create your own password for your account.</p>
                </div>
                
                <div class="btn-container">
                  <a href="{{magicLink}}" class="btn">Set Up Your Password</a>
                </div>
                
                <div class="divider"></div>
                
                <p style="color: #6b7280; font-size: 14px;">If the button above doesn't work, copy and paste this link into your browser:</p>
                <div class="link-text">{{magicLink}}</div>
                
                <div class="alert-box">
                  <p><strong>Security Notice:</strong> This link will expire in 2 hours for your security. If you don't set up your password within this time, please contact your administrator for a new link.</p>
                </div>
                
                <p style="margin-top: 25px;">Welcome to Jobready,<br>The Jobready Team</p>
              </td>
            </tr>
          </table>
          
          <!-- Footer -->
          <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
            <tr>
              <td class="footer">
                <p>Powered by <a href="https://jobready.co">Jobready.co</a></p>
                
                <div class="social-links">
                  <a href="https://twitter.com/digitalagents" target="_blank">Twitter</a>
                  <a href="https://www.linkedin.com/company/job-readyai" target="_blank">LinkedIn</a>
                  <a href="https://github.com/digitalagents" target="_blank">GitHub</a>
                </div>
                
                <p class="copyright">&copy; {{year}} Jobready.co All rights reserved.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </div>
</body>
</html> 